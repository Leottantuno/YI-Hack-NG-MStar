#!/bin/sh
set -e

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

rm -rf ./_install/www
mkdir -p ./_install/www/cgi-bin
mkdir -p ./_install/www/img
mkdir -p ./_install/www/css
mkdir -p ./_install/www/js
mkdir -p ./_install/www/pages
ln -s /tmp/sd/record ./_install/www/record

echo "Bundling & minifying CSS..."
python3 -c "
import re
css_files = ['./httpd/htdocs/css/normalize.min.css', './httpd/htdocs/css/skeleton.min.css', './httpd/htdocs/css/custom.css']
content = ''
for f in css_files:
    with open(f, 'r') as fh: content += fh.read() + '\n'
content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
content = re.sub(r'\s+', ' ', content)
content = re.sub(r'\s*([{:;,>+])\s*', r'\1', content)
with open('./_install/www/css/all.css', 'w') as fh:
    fh.write(content.strip())
"

echo "Bundling & minifying JS..."
cp ./httpd/htdocs/js/jquery.min.js ./_install/www/js/jquery.min.js
python3 -c "
import re, glob
js_files = ['./httpd/htdocs/js/utils.js', './httpd/htdocs/js/app.js'] + sorted(glob.glob('./httpd/htdocs/js/modules/*.js'))
lines = []
in_multi = False
for f in js_files:
    with open(f, 'r') as fh:
        for line in fh:
            line = line.strip()
            if not line: continue
            if in_multi:
                if '*/' in line:
                    in_multi = False
                    line = line[line.find('*/')+2:].strip()
                else: continue
            if '/*' in line:
                if '*/' in line:
                    line = re.sub(r'/\*.*?\*/', '', line).strip()
                else:
                    in_multi = True
                    line = line[:line.find('/*')].strip()
            if line.startswith('//'): continue
            if line: lines.append(line)
with open('./_install/www/js/all.js', 'w') as fh:
    fh.write('\n'.join(lines))
"

echo "Copying HTML and assets..."
cp ./httpd/htdocs/index.html ./_install/www/index.html
cp ./httpd/htdocs/pages/*.html ./_install/www/pages/
cp -R ./httpd/htdocs/img/. ./_install/www/img/
cp -R ./httpd/cgi-bin/* ./_install/www/cgi-bin/

echo "Compressing web assets with GZIP -9..."
find ./_install/www/* -type f -not \( -path './_install/www/cgi-bin/*' -prune \) -exec gzip -f -9 {} +

echo "Web UI compilation succeeded."
